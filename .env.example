# Copy to .env.local for local development.
# Never commit real .env* files with populated values.

# Optional native analytics key.
VITE_APTABASE_KEY=

# RevenueCat public SDK keys for the optional in-app tip jar.
VITE_RC_IOS_KEY=
VITE_RC_ANDROID_KEY=

# Development/test only. Leave unset for production builds.
# VITE_RC_TEST_KEY=
# Local standalone native installs use the RevenueCat Test Store by default.
# Never set this for TestFlight/App Store builds.
# VITE_RC_USE_TEST_STORE=true

# Apple developer team ID for local iOS device signing (required for device
# builds; find it at developer.apple.com/account under Membership).
# IOS_DEVELOPMENT_TEAM=

# RevenueCat secret API key. Server-side only; never expose with VITE_.
REVENUECAT_SECRET_KEY=
