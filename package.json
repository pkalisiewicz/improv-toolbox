{
  "name": "improv-app",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/generate-sw.mjs",
    "build:en": "VITE_BUILD_LANG=en npm run build",
    "build:pl": "VITE_BUILD_LANG=pl npm run build",
    "build:spa": "npm run build:pl",
    "build:native": "VITE_BUILD_TARGET=native VITE_BUILD_LANG=en react-router build",
    "sync:native": "npm run build:native && npx cap sync",
    "ios": "npm run sync:native && npx cap run ios",
    "ios:dev": "node scripts/dev-ios.mjs",
    "ios:standalone": "node scripts/dev-ios.mjs --standalone",
    "ios:devices": "npx cap run ios --list",
    "assets:native": "node scripts/generate-native-assets.mjs && npx @capacitor/assets generate --ios --iconBackgroundColor '#0B0E0B' --splashBackgroundColor '#0B0E0B' --splashBackgroundColorDark '#0B0E0B'",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=~/.cache/ms-playwright playwright test",
    "test:e2e:ui": "PLAYWRIGHT_BROWSERS_PATH=~/.cache/ms-playwright playwright test --ui"
  },
  "dependencies": {
    "@aptabase/web": "^0.5.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/device": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@fontsource-variable/big-shoulders-display": "^5.2.5",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/fredoka": "^5.2.10",
    "@fontsource-variable/hanken-grotesk": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/nunito": "^5.2.7",
    "@react-router/node": "^7.18.0",
    "@revenuecat/purchases-capacitor": "^13.2.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "isbot": "^5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.1",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@react-router/dev": "^7.18.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "workbox-build": "^7.4.1"
  }
}
