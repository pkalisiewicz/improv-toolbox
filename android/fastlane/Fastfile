# fastlane Fastfile — Google Play uploads for Improv Toolbox.
#
# Run from the android/ directory (fastlane finds this file automatically):
#   cd android && fastlane internal
#
# Prerequisites (one-time, see docs/publishing-checklist.md §8):
#   1. The app record exists in Play Console (the FIRST app creation is manual —
#      the API cannot create a new listing).
#   2. A service-account JSON key with "Release to testing tracks" — path set via
#      PLAY_JSON_KEY (see Appfile).
#   3. A fresh signed AAB at the path below (npm run sync:native, then
#      JAVA_HOME=~/.jdks/jdk-21.0.11+10/Contents/Home ./gradlew bundleRelease).

default_platform(:android)

# Signed release bundle produced by `./gradlew bundleRelease`.
AAB = File.expand_path("../app/build/outputs/bundle/release/app-release.aab", __dir__)

platform :android do
  desc "Validate the whole upload against Play WITHOUT publishing anything (dry run)"
  lane :validate do
    upload_to_play_store(
      aab: AAB,
      track: "internal",
      validate_only: true,
      release_status: "draft"
    )
  end

  desc "Upload the signed AAB + listing to the INTERNAL testing track (fast smoke test)"
  lane :internal do
    upload_to_play_store(
      aab: AAB,
      track: "internal",
      # 'draft' lets you review in the console before releasing to testers;
      # switch to 'completed' to release immediately.
      release_status: "draft"
    )
  end

  desc "Upload to a CLOSED testing track (the 12-tester / 14-day gate). Override: track:alpha_custom status:draft"
  lane :closed do |options|
    upload_to_play_store(
      aab: AAB,
      track: options[:track] || "alpha",
      # 'completed' rolls out to testers (starts the 14-day clock) but requires the
      # app to be OUT of draft status (finish app-content declarations first).
      # While the app is still a draft in Play Console, only 'draft' is accepted.
      release_status: options[:status] || "completed"
    )
  end

  desc "Upload to PRODUCTION (only after closed testing clears). Staged rollout via rollout:0.1"
  lane :production do |options|
    upload_to_play_store(
      aab: AAB,
      track: "production",
      release_status: "completed",
      rollout: options[:rollout] # e.g. "0.1" for a 10% staged rollout; nil = 100%
    )
  end

  desc "Roll out / promote an ALREADY-uploaded versionCode on a track — no new binary.
Use this to flip a staged draft to a live rollout, or to promote the exact bytes
testers validated. e.g. fastlane rollout version_code:3 track:alpha"
  lane :rollout do |options|
    upload_to_play_store(
      track: options[:track] || "alpha",
      version_code: Integer(options[:version_code] || 3),
      release_status: options[:status] || "completed",
      # Mutate only the track's release status; re-uploading would trip Play's
      # "version code has already been used" uniqueness check.
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Push listing text + graphics ONLY (no binary): title, short/full descriptions, icon,
feature graphic, screenshots for every locale. Override the release context with
track:/version_code: — default alpha:3 (the current closed release)."
  lane :metadata do |options|
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      # supply always reconciles a track's release; without a resolvable version code
      # it errors "no release for version code '' ". Point it at the current release
      # and skip release notes (those are release-scoped and ship with the binary lanes).
      track: options[:track] || "alpha",
      version_code: Integer(options[:version_code] || 3),
      skip_upload_changelogs: true
    )
  end
end
